# ====================================================
# EasyPicker2 Docker 环境变量配置
# 复制本文件为 .env.docker 后按需修改
# ====================================================

# 宿主机映射端口（容器内固定 80）
EP_PORT=6478

# ----- 服务端 -----
SERVER_PORT=3000
SERVER_HOST=127.0.0.1

# ----- MariaDB（容器内置）-----
# ⚠️ 生产环境建议修改 MYSQL_DB_PWD；首次启动后修改需同步变更库内 root 密码
MYSQL_DB_HOST=127.0.0.1
MYSQL_DB_PORT=3306
MYSQL_DB_NAME=easypicker2
MYSQL_DB_USER=root
MYSQL_DB_PWD=easypicker2

# ----- MongoDB（容器内置）-----
MONGO_DB_HOST=127.0.0.1
MONGO_DB_PORT=27017
MONGO_DB_NAME=easypicker2
MONGO_DB_NEED_AUTH=false

# ----- KV 存储 -----
# 默认本地文件 KV（无需 Redis）；如需用 Redis 作 KV 后端，设 KV_STORE=redis 并提供 REDIS_DB_* 连接
# KV_STORE=redis

# ----- 存储模式 -----
# 默认本地存储（local）；如需七牛云改为 qiniu
EP_DEFAULT_STORAGE_MODE=local
# 本地存储文件根目录（已挂载到 ./data/upload，一般无需修改）
UPLOAD_DIR=/usr/share/easypicker/server/upload

# ----- 启动行为 -----
# 启动时自动建库并导入初始表结构（首次启动用，已有数据时自动跳过）
EP_AUTO_CREATE_DB=true

# ----- PM2 进程守护（Node 崩溃只重启 Node，不影响 DB/Nginx）-----
# 两次重启之间的间隔（毫秒）
EP_RESTART_DELAY=3000
# 最大重启次数（超出则交由 Docker restart 策略兜底，整容器重启）
EP_MAX_RESTARTS=10
# 内存阈值重启（防内存泄漏），超出则重启 Node
EP_MAX_MEMORY_RESTART=1G

# 七牛云配置（仅 storageMode=qiniu 时需要，默认本地存储可忽略）
# QINIU_ACCESS_KEY=
# QINIU_SECRET_KEY=
# QINIU_BUCKET_NAME=
# QINIU_BUCKET_DOMAIN=
# QINIU_BUCKET_ZONE=huanan
