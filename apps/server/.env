# MySQL 数据库相关
MYSQL_DB_HOST=127.0.0.1
MYSQL_DB_PORT=3306
MYSQL_DB_NAME=ep-prod
MYSQL_DB_USER=easypicker2
MYSQL_DB_PWD=easypicker2

MONGO_DB_HOST=127.0.0.1
MONGO_DB_PORT=27017
MONGO_DB_NAME=ep-prod
MONGO_DB_USER=testuser
MONGO_DB_PWD=testpwd
MONGO_DB_NEED_AUTH=false

REDIS_DB_HOST=127.0.0.1
REDIS_DB_PORT=6379
REDIS_DB_PASSWORD=testpwd
REDIS_DB_NEED_AUTH=false

# 服务相关
SERVER_PORT=3000
SERVER_HOST=127.0.0.1

# 七牛云相关
# https://docs.ep.sugarat.top/deploy/qiniu.html
QINIU_ACCESS_KEY=AccessKey
QINIU_SECRET_KEY=SecretKey
QINIU_BUCKET_NAME=BucketName
QINIU_BUCKET_DOMAIN=BucketDomain
QINIU_BUCKET_IMAGE_COVER_STYLE=false
QINIU_BUCKET_IMAGE_PREVIEW_STYLE=false
QINIU_BUCKET_ZONE=huanan

# 腾讯云相关
# 密钥对
TENCENT_SECRET_ID=test
TENCENT_SECRET_KEY=test
# 短信模板相关
TENCENT_MESSAGE_TemplateID=12345
TENCENT_MESSAGE_SmsSdkAppid=12345
TENCENT_MESSAGE_SignName=粥里有勺糖

# 支付宝支付（通过 alipay-service 中转平台完成收款）
# 业务方不再直接持有支付宝密钥，仅保留总开关与业务侧限额
ALIPAY_ENABLED=false
ALIPAY_MIN_AMOUNT=0.01
ALIPAY_MAX_AMOUNT=5000
ALIPAY_DAILY_LIMIT=20000
ALIPAY_ORDER_EXPIRE_MINUTES=30
# alipay-service 中转平台连接配置
ALIPAY_RELAY_ENABLED=false
ALIPAY_RELAY_BASE_URL=
ALIPAY_RELAY_APP_ID=
ALIPAY_RELAY_APP_SECRET=
# 或者通过文件读取：ALIPAY_RELAY_APP_SECRET_PATH=/path/to/secret
ALIPAY_RELAY_NOTIFY_PATH=/api/pay/alipay/notify
ALIPAY_RELAY_TIMEOUT_MS=10000